---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
}

const {
  src,
  alt = 'Essay cover',
  caption,
} = Astro.props;
---

<div class="poster-wrap">
  <figure class="cover">
    <img class="cover-image" src={src} alt={alt} width="1024" height="576" />
    {
      caption && (
        <figcaption class="caption">{caption}</figcaption>
      )
    }
  </figure>
</div>
