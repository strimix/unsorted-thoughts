---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import {
  alternateHref,
  formatDate,
  getLocaleFromId,
  getSlugFromId,
  ruEnabled,
  thoughtHref,
  t,
} from '../lib/i18n';

const locale = 'en' as const;
const copy = t(locale);
const switchHref = ruEnabled ? alternateHref(locale) : undefined;

const thoughts = (await getCollection('thoughts'))
  .filter((thought) => !thought.data.draft && getLocaleFromId(thought.id) === locale)
  .sort((a, b) => b.data.number - a.data.number);
---

<BaseLayout
  title={copy.siteTitle}
  description={copy.siteDescription}
  locale={locale}
  alternateUrl={switchHref}
>
  <header class="top">
    <div class="top-inner">
      <a class="brand" href="/">unsorted<span>.</span>club</a>
      {
        ruEnabled && switchHref && (
          <div class="top-right">
            <LangSwitch locale={locale} href={switchHref} />
          </div>
        )
      }
    </div>
  </header>

  <main>
    <section class="index-hero">
      <h1>{copy.heroTitle}</h1>
      <p class="dek">{copy.heroDek}</p>
    </section>

    <ol class="thought-list">
      {
        thoughts.map((thought) => {
          const fullTitle = thought.data.titleEmphasis
            ? `${thought.data.title} ${thought.data.titleEmphasis}`
            : thought.data.title;
          const padded = String(thought.data.number).padStart(3, '0');
          const slug = getSlugFromId(thought.id);
          return (
            <li>
              <a href={thoughtHref(locale, slug)}>
                <span class="thought-num">No. {padded}</span>
                <span>
                  <p class="thought-title">{fullTitle}</p>
                  <span class="thought-meta">
                    {formatDate(thought.data.date, locale)}
                    <span class="dot"> / </span>
                    {thought.data.tags.map((tag) => tag.toUpperCase()).join(' · ')}
                  </span>
                </span>
                <span class="thought-read">{copy.minShort(thought.data.minutes)}</span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </main>
</BaseLayout>
