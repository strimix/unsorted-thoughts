---
import BaseLayout from './BaseLayout.astro';
import CoverPoster from '../components/CoverPoster.astro';
import LangSwitch from '../components/LangSwitch.astro';
import {
  alternateHref,
  formatDate,
  homeHref,
  type Locale,
  ruEnabled,
  t,
} from '../lib/i18n';

interface Props {
  title: string;
  titleEmphasis?: string;
  dek: string;
  date: Date;
  tags: string[];
  minutes: number;
  number: number;
  coverImage?: string;
  coverAlt?: string;
  coverCaption?: string;
  ogImage?: string;
  locale?: Locale;
  slug: string;
}

const {
  title,
  titleEmphasis,
  dek,
  date,
  tags,
  minutes,
  number,
  coverImage,
  coverAlt,
  coverCaption,
  ogImage,
  locale = 'en',
  slug,
} = Astro.props;

const copy = t(locale);
const padded = String(number).padStart(3, '0');
const dateLabel = formatDate(date, locale);
const tagsLabel = tags.map((tag) => tag.toUpperCase()).join(' · ');
const fullTitle = titleEmphasis ? `${title} ${titleEmphasis}` : title;
const pageTitle = `${fullTitle} — unsorted.club`;
const shareImage = ogImage ?? coverImage;
const switchHref = ruEnabled ? alternateHref(locale, slug) : undefined;
---

<BaseLayout
  title={pageTitle}
  description={dek}
  image={shareImage}
  type="article"
  locale={locale}
  alternateUrl={switchHref}
>
  <div class="progress" id="progress"></div>
  <header class="top">
    <div class="top-inner">
      <a class="brand" href={homeHref(locale)}>unsorted<span>.</span>club</a>
      {
        ruEnabled && switchHref && (
          <div class="top-right">
            <LangSwitch locale={locale} href={switchHref} />
          </div>
        )
      }
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="eyebrow">No. {padded}</div>
      <h1>
        {
          titleEmphasis ? (
            <>
              {title} <em>{titleEmphasis}</em>
            </>
          ) : (
            title
          )
        }
      </h1>
      <p class="dek">{dek}</p>
      <div class="meta">
        <b>{tagsLabel}</b>
        <span class="dot">/</span>
        <span>{dateLabel}</span>
        <span class="dot">/</span>
        <span>{copy.minRead(minutes)}</span>
      </div>
    </section>

    {
      coverImage && (
        <CoverPoster
          src={coverImage}
          alt={coverAlt}
          caption={coverCaption}
        />
      )
    }

    <div class="content-shell" id="article">
      <article class="article">
        <slot />
        <div class="endmark">■</div>
      </article>
    </div>
  </main>

  <footer class="footer">
    <a href="#top">{copy.backToTop}</a>
  </footer>

  <script>
    const progress = document.getElementById('progress');
    function update() {
      if (!progress) return;
      const d = document.documentElement;
      progress.style.width =
        (100 * scrollY) / Math.max(1, d.scrollHeight - innerHeight) + '%';
    }
    addEventListener('scroll', update, { passive: true });
    update();
  </script>
</BaseLayout>
