---
import BaseLayout from './BaseLayout.astro';
import CoverPoster from '../components/CoverPoster.astro';

interface Props {
  title: string;
  titleEmphasis?: string;
  dek: string;
  date: Date;
  tags: string[];
  minutes: number;
  number: number;
  coverImage?: string;
  coverAlt?: string;
  coverCaption?: string;
  ogImage?: string;
}

const {
  title,
  titleEmphasis,
  dek,
  date,
  tags,
  minutes,
  number,
  coverImage,
  coverAlt,
  coverCaption,
  ogImage,
} = Astro.props;

const padded = String(number).padStart(3, '0');
const dateLabel = date
  .toLocaleDateString('en-GB', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  })
  .toUpperCase();
const tagsLabel = tags.map((t) => t.toUpperCase()).join(' · ');
const fullTitle = titleEmphasis ? `${title} ${titleEmphasis}` : title;
const pageTitle = `${fullTitle} — unsorted.club`;
const shareImage = ogImage ?? coverImage;
---

<BaseLayout
  title={pageTitle}
  description={dek}
  image={shareImage}
  type="article"
>
  <div class="progress" id="progress"></div>
  <header class="top">
    <div class="top-inner">
      <a class="brand" href="/">unsorted<span>.</span>club</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="eyebrow">No. {padded}</div>
      <h1>
        {
          titleEmphasis ? (
            <>
              {title} <em>{titleEmphasis}</em>
            </>
          ) : (
            title
          )
        }
      </h1>
      <p class="dek">{dek}</p>
      <div class="meta">
        <b>{tagsLabel}</b>
        <span class="dot">/</span>
        <span>{dateLabel}</span>
        <span class="dot">/</span>
        <span>~{minutes} MIN READ</span>
      </div>
    </section>

    {
      coverImage && (
        <CoverPoster
          src={coverImage}
          alt={coverAlt}
          caption={coverCaption}
        />
      )
    }

    <div class="content-shell" id="article">
      <article class="article">
        <slot />
        <div class="endmark">■</div>
      </article>
    </div>
  </main>

  <footer class="footer">
    <a href="#top">BACK TO TOP ↑</a>
  </footer>

  <script>
    const progress = document.getElementById('progress');
    function update() {
      if (!progress) return;
      const d = document.documentElement;
      progress.style.width =
        (100 * scrollY) / Math.max(1, d.scrollHeight - innerHeight) + '%';
    }
    addEventListener('scroll', update, { passive: true });
    update();
  </script>
</BaseLayout>
