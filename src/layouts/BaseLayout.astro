---
import '../styles/global.css';
import type { Locale } from '../lib/i18n';
import { t } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  themeColor?: string;
  image?: string;
  type?: 'website' | 'article';
  locale?: Locale;
  alternateUrl?: string;
}

const {
  title,
  description,
  themeColor = '#faf9f6',
  image,
  type = 'website',
  locale = 'en',
  alternateUrl,
} = Astro.props;

const copy = t(locale);
const resolvedDescription = description ?? copy.siteDescription;
const site = Astro.site ?? new URL('https://thoughts.unsorted.club');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image ? new URL(image, site).href : undefined;
const ogImageType = image?.match(/\.(jpe?g|png|gif|webp)$/i)?.[1]
  ?.toLowerCase()
  .replace('jpg', 'jpeg');
const alternateAbsolute = alternateUrl
  ? new URL(alternateUrl, site).href
  : undefined;
const alternateLocale = locale === 'en' ? 'ru' : 'en';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      alternateAbsolute && (
        <>
          <link rel="alternate" hreflang={alternateLocale} href={alternateAbsolute} />
          <link rel="alternate" hreflang={locale} href={canonical} />
          <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonical : alternateAbsolute} />
        </>
      )
    }
    <title>{title}</title>

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    {
      alternateLocale && (
        <meta
          property="og:locale:alternate"
          content={alternateLocale === 'ru' ? 'ru_RU' : 'en_US'}
        />
      )
    }
    <meta property="og:site_name" content="unsorted.club" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={resolvedDescription} />
    {
      ogImage && (
        <>
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="627" />
          {ogImageType && (
            <meta property="og:image:type" content={`image/${ogImageType}`} />
          )}
          <meta property="og:image:alt" content={title} />
        </>
      )
    }

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={resolvedDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body>
    <slot />
  </body>
</html>
